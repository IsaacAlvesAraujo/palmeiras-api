        "url": "{{baseUrl}}/estadios",
        "body": {
          "mode": "raw",
          "raw": "{\"nome\": \"Allianz Parque\", \"endereco\": \"São Paulo\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if(pm.response.code===201)pm.collectionVariables.set(\"estadiosId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Repetir estadios",
