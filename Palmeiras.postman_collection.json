{
  "info": {
    "name": "Palmeiras API — Parte 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminKey",
      "value": "ALTERE_LOCALMENTE"
    },
    {
      "key": "apiKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Gerar chave (admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Idempotency-Key",
            "value": "{{runId}}-key"
          },
          {
            "key": "X-API-Key",
            "value": "{{adminKey}}"
          }
        ],
        "url": "{{baseUrl}}/api-keys",
        "body": {
          "mode": "raw",
          "raw": "{\"usuario\": \"demo\"}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set(\"runId\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if(pm.response.code===201){pm.collectionVariables.set(\"apiKey\",pm.response.json().apiKey);pm.collectionVariables.set(\"keyId\",pm.response.json().id);}"
            ]
          }
        }
      ]
    },
    {
      "name": "Criar estadios",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json"
