        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Mesmo ID\",()=>pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get(\"estadiosId\").toString()));pm.test(\"Replay\",()=>pm.expect(pm.response.headers.get(\"Idempotent-Replayed\")).to.eql(\"true\"));"
